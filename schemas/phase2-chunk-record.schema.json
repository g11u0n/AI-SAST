{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI SAST Phase 2 Chunk record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_commit_sha", "target_scope_sha256", "chunk_id",
    "chunk_identity_sha256", "path", "git_blob_oid", "language", "source_encoding",
    "parse_mode", "kind", "node_type", "parent_kind", "split_mode",
    "structural_kinds", "node_types", "structural_unit_start_byte",
    "structural_unit_end_byte_exclusive", "structural_unit_kind", "file_chunk_ordinal", "start_byte",
    "end_byte_exclusive", "start_line", "start_column_byte", "end_line", "end_point_line",
    "end_column_byte_exclusive", "raw_content_sha256", "raw_size_bytes",
    "rendered_content_sha256", "rendered_content_utf8_bytes", "token_count_kind",
    "token_counter", "evidence_frame_sha256", "evidence_frame_utf8_bytes", "token_count"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "target_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunk_id": {"type": "string", "pattern": "^C1-[0-9a-f]{24}$"},
    "chunk_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "git_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "language": {"enum": ["c", "cpp"]},
    "source_encoding": {"enum": ["utf-8", "cp1252"]},
    "parse_mode": {"enum": ["PARSE_SUCCESS", "FALLBACK_SUCCESS"]},
    "kind": {"type": "string", "minLength": 1},
    "node_type": {"type": "string", "minLength": 1},
    "parent_kind": {"type": "string", "minLength": 1},
    "split_mode": {"type": "string", "minLength": 1},
    "structural_kinds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "node_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "structural_unit_start_byte": {"type": "integer", "minimum": 0},
    "structural_unit_end_byte_exclusive": {"type": "integer", "minimum": 1},
    "structural_unit_kind": {"type": "string", "minLength": 1},
    "file_chunk_ordinal": {"type": "integer", "minimum": 0},
    "start_byte": {"type": "integer", "minimum": 0},
    "end_byte_exclusive": {"type": "integer", "minimum": 1},
    "start_line": {"type": "integer", "minimum": 1},
    "start_column_byte": {"type": "integer", "minimum": 0},
    "end_line": {"type": "integer", "minimum": 1},
    "end_point_line": {"type": "integer", "minimum": 1},
    "end_column_byte_exclusive": {"type": "integer", "minimum": 0},
    "raw_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_size_bytes": {"type": "integer", "minimum": 1},
    "rendered_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rendered_content_utf8_bytes": {"type": "integer", "minimum": 1},
    "token_count_kind": {"const": "conservative_upper_bound"},
    "token_counter": {"const": "utf8_byte_upper_bound_v1"},
    "evidence_frame_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_frame_utf8_bytes": {"type": "integer", "minimum": 1, "maximum": 3840},
    "token_count": {"type": "integer", "minimum": 1, "maximum": 3840}
  }
}
