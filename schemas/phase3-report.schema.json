{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "status": {"const": "PASS"},
    "target_commit_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "target_scope_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "experiment_id": {"pattern": "^exp-v1-[0-9a-f]{24}$", "type": "string"},
    "index_bundle_id": {"pattern": "^I1-[0-9a-f]{24}$", "type": "string"},
    "index_bundle_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "counts": {"type": "object"},
    "artifact_sha256": {"type": "object"},
    "source_bytes": {"minimum": 1, "type": "integer"},
    "index_data_bytes": {"minimum": 1, "type": "integer"},
    "raw_source_or_security_judgment_stored": {"const": false, "type": "boolean"},
    "reproducibility": {
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["PENDING", "VERIFIED"]},
        "builds_compared": {"maximum": 2, "minimum": 0, "type": "integer"},
        "byte_identical": {"type": "boolean"}
      },
      "required": ["status", "builds_compared", "byte_identical"],
      "type": "object"
    }
  },
  "required": [
    "schema_version", "status", "target_commit_sha", "target_scope_sha256",
    "experiment_id", "index_bundle_id", "index_bundle_sha256", "counts",
    "artifact_sha256", "source_bytes", "index_data_bytes",
    "raw_source_or_security_judgment_stored", "reproducibility"
  ],
  "type": "object"
}
