{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI SAST Phase 2 Batch record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "target_commit_sha", "target_scope_sha256", "source_manifest_sha256",
    "chunking_contract_sha256", "file_manifest_sha256", "chunk_manifest_sha256",
    "batch_id", "batch_identity_sha256", "batch_ordinal", "renderer_version",
    "budget_counter", "budget_unit_rule", "max_payload_utf8_bytes", "chunk_ids",
    "chunk_count", "ordered_chunk_identity_sha256", "payload_sha256",
    "payload_utf8_bytes", "token_count", "token_count_kind"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "target_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunking_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunk_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_id": {"type": "string", "pattern": "^B1-[0-9a-f]{24}$"},
    "batch_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "batch_ordinal": {"type": "integer", "minimum": 0},
    "renderer_version": {"const": "evidence-frame-v1"},
    "budget_counter": {"const": "utf8_byte_upper_bound_v1"},
    "budget_unit_rule": {"const": "one_budget_unit_per_utf8_byte"},
    "max_payload_utf8_bytes": {"const": 3840},
    "chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C1-[0-9a-f]{24}$"}},
    "chunk_count": {"type": "integer", "minimum": 1},
    "ordered_chunk_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_utf8_bytes": {"type": "integer", "minimum": 1, "maximum": 3840},
    "token_count": {"type": "integer", "minimum": 1, "maximum": 3840},
    "token_count_kind": {"const": "conservative_upper_bound"}
  }
}
