# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Phase 0 compares generated contract artifacts byte-for-byte. Keep their
# canonical LF representation stable even when core.autocrlf is enabled.
*.json  text eol=lf
*.jsonl text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.ps1   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
